[Unit]
Description=KUHIN Django Application
After=network.target postgresql.service

[Service]
Type=notify
User=kuhin
Group=www-data
WorkingDirectory=/home/kuhin/kuhin

# Load environment variables from .env
EnvironmentFile=/home/kuhin/kuhin/.env

# Python executable from virtualenv
ExecStart=/home/kuhin/kuhin/venv/bin/gunicorn \
    --workers 3 \
    --worker-class sync \
    --worker-tmp-dir /dev/shm \
    --bind unix:/home/kuhin/kuhin/gunicorn.sock \
    --access-logfile /home/kuhin/kuhin/logs/gunicorn_access.log \
    --error-logfile /home/kuhin/kuhin/logs/gunicorn_error.log \
    --log-level info \
    --timeout 120 \
    kuhin_project.wsgi:application

# Auto-restart on failure
Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
